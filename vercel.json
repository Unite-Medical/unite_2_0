{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/proxy/:path*",
      "destination": "/api/proxy?__proxypath=:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/staff/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/cart/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/checkout/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/orders/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/invoices/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/quotes/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/q/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/rep/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/warehouse/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/work/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/distributor/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/activate/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/login/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/register/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/quote/engine/:path*",
      "destination": "/workspace.html"
    },
    {
      "source": "/quote/new/:path*",
      "destination": "/workspace.html"
    }
  ],
  "redirects": [
    {
      "source": "/pages/pdac-consulting",
      "destination": "/services/pdac",
      "permanent": true
    },
    {
      "source": "/pages/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/pages/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/pages/dealer-program",
      "destination": "/services/distributors",
      "permanent": true
    },
    {
      "source": "/pages/private-labeling",
      "destination": "/services/private-label",
      "permanent": true
    },
    {
      "source": "/pages/pdac-approval-letters",
      "destination": "/services/pdac",
      "permanent": true
    },
    {
      "source": "/blogs/orthopedic-insights",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/collections/:slug*",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/education",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/services/dealer",
      "destination": "/services/distributors",
      "permanent": true
    },
    {
      "source": "/about/veteran-owned",
      "destination": "/procurement",
      "permanent": true
    },
    {
      "source": "/segments/gov",
      "destination": "/government",
      "permanent": true
    },
    {
      "source": "/surplus/market",
      "destination": "/surplus",
      "permanent": true
    },
    {
      "source": "/services/robotics",
      "destination": "/robotics",
      "permanent": true
    },
    {
      "source": "/solutions/asc",
      "destination": "/segments/asc",
      "permanent": true
    },
    {
      "source": "/solutions/pharmacy",
      "destination": "/segments/pharmacy",
      "permanent": true
    },
    {
      "source": "/solutions/government",
      "destination": "/government",
      "permanent": true
    },
    {
      "source": "/solutions/distributors",
      "destination": "/segments/distributors",
      "permanent": true
    },
    {
      "source": "/solutions/ems",
      "destination": "/segments/ems",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "staging.unitemedical.net"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(admin|staff|account|dashboard|cart|checkout|orders|invoices|quotes|q|vendor|rep|warehouse|work|distributor|activate|login|register)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/quote/(engine|new)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/internal/restore-savings-refresh",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/customerio/outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/webhooks/process",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/operations-refresh",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/qbo/order-outbox",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/admin/commerce-workspace.js": {
      "includeFiles": "api/_data/*.json",
      "maxDuration": 60
    },
    "api/admin/commerce-assistant.js": {
      "maxDuration": 60,
      "includeFiles": "{public/brand/**,node_modules/pdfkit/js/data/*}"
    },
    "api/admin/order-drafts.js": {
      "maxDuration": 60
    },
    "api/qbo/order-outbox.js": {
      "maxDuration": 60
    },
    "api/public/inquiry.js": {
      "maxDuration": 60
    },
    "api/admin/robotics-sync.js": {
      "maxDuration": 60
    },
    "api/admin/business-intelligence.js": {
      "maxDuration": 60
    },
    "api/admin/inventory-evidence.js": {
      "maxDuration": 60
    }
  }
}
